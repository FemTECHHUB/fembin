DATABASE_URL=mysql+pymysql://fembin:fembin@localhost:3307/fembin

BUSY_HOST=127.0.0.1
BUSY_PORT=981
BUSY_USERNAME=
BUSY_PASSWORD=

CATALOG_SYNC_ENABLED=true
# AUTO-RESYNC: how often the catalog is re-pulled from BUSY and pushed to WooCommerce.
# Set low (e.g. 30) so a price/name change made in BUSY shows up in the store quickly.
# NOTE: this in-process loop only runs while the app process stays resident. On
# cPanel/Passenger the process may idle/recycle — prefer a cron job calling
# scripts/run_catalog_sync_once.py (DEPLOYMENT.md step 9) on that host, which works
# regardless of process lifetime.
CATALOG_SYNC_INTERVAL_SECONDS=30

# How products sync deals with BUSY edits (CLAUDE.md §8): BUSY's Stamp does NOT advance on
# item edits, so Stamp-incremental silently misses name/price changes.
#   "full"      — full Master1 re-pull every run (+ per-item GetMasterXML). Correct; cheap on
#                 a small catalog, heavy on a large install.
#   "stamp"     — Stamp-incremental only. Cheapest, but MISSES edits.
#   "reconcile" — Stamp-incremental normally, full re-pull at least every
#                 CATALOG_SYNC_PRODUCTS_RECONCILE_INTERVAL_SECONDS. Best for a bigger install.
CATALOG_SYNC_PRODUCTS_STRATEGY=full
CATALOG_SYNC_PRODUCTS_RECONCILE_INTERVAL_SECONDS=3600

WOO_SITE_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
WOO_NEW_PRODUCT_STATUS=private

OUTBOX_WORKER_ENABLED=false
OUTBOX_WORKER_INTERVAL_SECONDS=5

# Auth — MUST be overridden with a real random secret outside of dev (CLAUDE.md §6).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-change-me-3f8a1c9d7b2e4f60a5d8c1b3e7f92046
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

LOG_LEVEL=INFO
