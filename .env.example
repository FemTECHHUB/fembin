DATABASE_URL=mysql+pymysql://fembin:fembin@localhost:3307/fembin

BUSY_HOST=127.0.0.1
BUSY_PORT=981
BUSY_USERNAME=
BUSY_PASSWORD=

CATALOG_SYNC_ENABLED=true
# AUTO-RESYNC: how often the catalog is re-pulled from BUSY and pushed to WooCommerce.
# Set low (e.g. 30) so a price/name change made in BUSY shows up in the store quickly.
# NOTE: this in-process loop only runs while the app process stays resident. On
# cPanel/Passenger the process may idle/recycle — prefer a cron job calling
# scripts/run_catalog_sync_once.py (DEPLOYMENT.md step 9) on that host, which works
# regardless of process lifetime.
CATALOG_SYNC_INTERVAL_SECONDS=30

# How products sync deals with BUSY edits (CLAUDE.md §8): BUSY's Stamp does NOT advance on
# item edits, so Stamp-incremental silently misses name/price changes.
#   "full"      — full Master1 re-pull every run (+ per-item GetMasterXML). Correct; cheap on
#                 a small catalog (fine for THIS repo's own ~9-item test company), but at
#                 real scale — confirmed live 2026-10-15 against a 14,314-item install — one
#                 full pass can take upwards of an hour. On a short interval this means the
#                 sync loop never stops full-scanning BUSY, which is what caused repeated
#                 "BUSY session drops" that day. Do NOT use "full" on an install anywhere
#                 near that size.
#   "stamp"     — Stamp-incremental only. Cheapest, but MISSES edits.
#   "reconcile" — Stamp-incremental normally, full re-pull at least every
#                 CATALOG_SYNC_PRODUCTS_RECONCILE_INTERVAL_SECONDS. Use this on any install
#                 with more than a couple hundred items.
CATALOG_SYNC_PRODUCTS_STRATEGY=reconcile
CATALOG_SYNC_PRODUCTS_RECONCILE_INTERVAL_SECONDS=3600
# How many items' detail calls run concurrently during products sync — see
# app/domain/catalog/sync.py's sync_products docstring. Keep modest.
CATALOG_SYNC_PRODUCTS_DETAIL_CONCURRENCY=8

WOO_SITE_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
WOO_NEW_PRODUCT_STATUS=private

OUTBOX_WORKER_ENABLED=false
OUTBOX_WORKER_INTERVAL_SECONDS=5

# Auth — MUST be overridden with a real random secret outside of dev (CLAUDE.md §6).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-change-me-3f8a1c9d7b2e4f60a5d8c1b3e7f92046
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

LOG_LEVEL=INFO

# Public interactive API docs (/docs, /redoc, /openapi.json) — a 2026-10-16 production-
# readiness audit flagged these as exposing the full API surface with no auth. Fine for
# dev; DEPLOYMENT.md's checklist requires this be false in production.
API_DOCS_ENABLED=true

# Per-IP request budget for POST /auth/login (slowapi syntax, e.g. "10/minute",
# "100/hour") — unlimited login attempts was a real gap found in that same audit.
LOGIN_RATE_LIMIT=10/minute
